{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://justice.gov.uk/core/courts/nowdocument/now-document-content.json",
  "description": "The contents of a now document",
  "type": "object",
  "properties": {
    "orderName": {
      "type": "string"
    },
    "welshOrderName": {
      "type": "string"
    },
    "courtClerkName": {
      "type": "string"
    },
    "orderDate": {
      "type": "string",
      "format": "date"
    },
    "amendmentDate": {
      "type": "string",
      "format": "date"
    },
    "orderingCourt": {
      "$ref": "http://justice.gov.uk/core/courts/nowdocument/order-court.json"
    },
    "orderAddressee": {
      "$ref": "http://justice.gov.uk/core/courts/nowdocument/order-addressee.json"
    },
    "defendant": {
      "$ref": "http://justice.gov.uk/core/courts/nowdocument/nowdefendant.json"
    },
    "applicants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "http://justice.gov.uk/core/courts/nowdocument/now-party.json"
      }
    },
    "respondents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "http://justice.gov.uk/core/courts/nowdocument/now-party.json"
      }
    },
    "thirdParties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "http://justice.gov.uk/core/courts/nowdocument/now-party.json"
      }
    },
    "parentGuardian": {
      "$ref": "http://justice.gov.uk/core/courts/nowdocument/now-party-parent-guardian.json"
    },
    "financialOrderDetails": {
      "$ref": "http://justice.gov.uk/core/courts/nowdocument/financial-order-details.json"
    },
    "nextHearingCourtDetails": {
      "$ref": "http://justice.gov.uk/core/courts/nowdocument/next-hearing-court-details.json"
    },
    "civilNow": {
      "description": "Indicates that the now refers to offences that are civil rather than criminal",
      "type": "boolean"
    },
    "cases": {
      "title": "cases",
      "type": "array",
      "items": {
        "$ref": "http://justice.gov.uk/core/courts/nowdocument/prosecution-case.json"
      }
    },
    "distinctResults": {
      "description": "Only provided when there are distinct result requirement settings for a given now.  Provides a distinct collection of results and their prompts across defendants, offences and prosecution cases",
      "type": "array",
      "items": {
        "$ref": "http://justice.gov.uk/core/courts/nowdocument/result.json"
      }
    },
    "distinctPrompts": {
      "description": "Only provided when there are distinct result requirement settings for a given now.  Provides a distinct collection of prompts across defendants, offences and prosecution cases",
      "type": "array",
      "items": {
        "$ref": "http://justice.gov.uk/core/courts/nowdocument/prompt.json"
      }
    },
    "caseApplicationReferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nowText": {
      "title": "nowTextItems",
      "description": "A collection of all the now text items for the given now",
      "type": "array",
      "items": {
        "$ref": "http://justice.gov.uk/core/courts/nowdocument/now-text.json"
      }
    },
    "nowRequirementText": {
      "title": "nowRequirementTextItems",
      "description": "A collection of all the now requirement text items for now requirements associated to the given now",
      "type": "array",
      "items": {
        "$ref": "http://justice.gov.uk/core/courts/nowdocument/now-text.json"
      }
    }
  },
  "required": [
    "orderName",
    "courtClerkName",
    "orderDate"
  ],
  "additionalProperties": false
}