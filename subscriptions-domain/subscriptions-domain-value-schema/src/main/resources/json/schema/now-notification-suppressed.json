{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://cpp.moj.gov.uk/subscriptions/json/schemas/now-notification-suppressed-v2.json",
  "description": "The details required to suppress a now document",
  "type": "object",

  "properties": {
    "materialId": {
      "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/uuid"
    },
    "masterDefendantId": {
      "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/uuid"
    },
    "defendantName": {
      "type": "string"
    },
    "caseUrns": {
      "description": "defendant cases",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "templateName": {
      "type": "string"
    }
  },
  "required": [
    "materialId",
    "masterDefendantId",
    "defendantName",
    "caseUrns",
    "templateName"
  ],
  "additionalProperties": false
}