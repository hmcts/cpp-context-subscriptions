{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://cpp.moj.gov.uk/subscriptions/json/schemas/nowdefendant-v2.json",
  "description": "The details of a defendant rendered in a now document",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "dateOfBirth": {
      "type": "string",
      "format": "date"
    },
    "address": {
      "$ref": "http://cpp.moj.gov.uk/subscriptions/json/schemas/nowaddress-v2.json"
    },
    "pncId": {
      "type": "string"
    },
    "nationality": {
      "type": "string"
    },
    "prosecutingAuthorityReference": {
      "description": "aka defendantASN when authority is a police force",
      "type": "string"
    },
    "mobileNumber": {
      "type": "string"
    },
    "landLineNumber": {
      "type": "string"
    },
    "nationalInsuranceNumber": {
      "type": "string"
    },
    "ethnicity": {
      "type": "string"
    },
    "gender": {
      "type": "string"
    },
    "driverNumber": {
      "type": "string"
    },
    "defendantResults": {
      "type": "array",
      "items": {
        "$ref": "http://cpp.moj.gov.uk/subscriptions/json/schemas/result-v2.json"
      }
    },
    "solicitor": {
      "$ref": "http://cpp.moj.gov.uk/subscriptions/json/schemas/nowsolicitor-v2.json"
    },
    "occupation": {
      "type": "string"
    },
    "occupationWelsh": {
      "type": "string"
    },
    "aliasNames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string"
    },
    "firstName": {
      "type": "string"
    },
    "middleName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "isCivil": {
      "type": "boolean"
    },
    "selfDefinedEthnicity": {
      "type": "string"
    },
    "interpreterLanguageNeeds": {
      "description": "The person interpreter needs",
      "type": "string"
    },
    "specialNeeds": {
      "description": "The person special needs indicted any special needs that must be met by the courts process e.g. wheelchair access",
      "type": "string"
    },
    "isYouth": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false
}